{
  "name": "digit-fsm-frontend",
  "version": "0.1.0",
  "description": "DIGIT FSM frontends — design tokens, shared UI, console, portal, and mobile.",
  "private": true,
  "type": "module",
  "author": "DIGIT <alaalsalam101@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "design",
    "ui",
    "api",
    "console",
    "portal",
    "mobile"
  ],
  "scripts": {
    "prepare": "cd .. && husky frontend/.husky || true",
    "tokens": "yarn workspace @digit/design build",
    "dev:console": "yarn workspace @digit/console dev",
    "dev:portal": "yarn workspace @digit/portal dev",
    "dev:mobile": "yarn workspace @digit/mobile dev",
    "build": "yarn tokens && yarn build:console && yarn build:portal && yarn build:mobile",
    "build:console": "yarn workspace @digit/console build",
    "build:portal": "yarn workspace @digit/portal build",
    "build:mobile": "yarn workspace @digit/mobile build",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.55.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.4"
  }
}
